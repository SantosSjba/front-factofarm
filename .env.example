# =============================================================================
# FactoFarm Frontend — variables de entorno
# Copia: cp .env.example .env
# =============================================================================

# URL base de la API Nest (prefijo /api/v1 incluido)
NG_APP_API_BASE_URL=http://localhost:3000/api/v1

# false en desarrollo local; true solo si sirves build de producción con ng serve
NG_APP_PRODUCTION=false

# --- Landing pública ---
# WhatsApp con código de país, sin + ni espacios
NG_APP_CONTACT_WHATSAPP=51944644276
NG_APP_CONTACT_EMAIL=contacto@factosysperu.com

# --- Datos legales (Libro de reclamaciones / proveedor) ---
NG_APP_COMPANY_LEGAL_NAME=FACTOSYS PERU S.A.C.
NG_APP_COMPANY_RUC=20614608952
NG_APP_COMPANY_ADDRESS=Trujillo, La Libertad, Perú. Atendemos todo el Perú (24 departamentos y Callao).

# --- SEO (dominio público de producción) ---
NG_APP_SITE_URL=https://factofarm.factosysperu.com
